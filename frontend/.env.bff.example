# ──────────────────────────────────────────────────────────────
# Stage 2 BFF 模式環境變數範例
# 使用方式：cp .env.bff.example .env.local
# 本地開發時，把 VITE_BFF_URL 指向 wrangler dev 的 port
# ──────────────────────────────────────────────────────────────

# BFF Worker 的 base URL（不含尾部斜線）
# 本地開發（wrangler dev）：
VITE_BFF_URL=http://localhost:8787/api
# Cloudflare Pages 生產環境（Workers 同網域，/api/* 由 Pages Function 路由）：
# VITE_BFF_URL=/api
